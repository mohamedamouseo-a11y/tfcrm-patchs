+const _waContactMutationCounts = new Map<number, number>();
+
+function beginWAGatewayContactMutation(sessionId: number) {
+  if (_waContactDeleteRunning.has(sessionId)) return false;
+  _waContactMutationCounts.set(
+    sessionId,
+    (_waContactMutationCounts.get(sessionId) ?? 0) + 1
+  );
+  return true;
+}
+
+function endWAGatewayContactMutation(sessionId: number) {
+  const remaining = (_waContactMutationCounts.get(sessionId) ?? 1) - 1;
+  if (remaining > 0) _waContactMutationCounts.set(sessionId, remaining);
+  else _waContactMutationCounts.delete(sessionId);
+}
+
+function hasWAGatewayContactMutation(sessionId: number) {
+  return (_waContactMutationCounts.get(sessionId) ?? 0) > 0;
+}
 

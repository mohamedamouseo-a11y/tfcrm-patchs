#!/usr/bin/env python3
from __future__ import annotations

import argparse
import re
import subprocess
from pathlib import Path

EXPECTED_BASE_SHA = "0b77201204fcaa79ccbd43798a7b7678ae2c5a4b"
PATCH_ID = "TFCRM_EGYPT_LOCATION_WALKIN_V1"


def read(path: Path) -> str:
    if not path.exists():
        raise SystemExit(f"Missing required file: {path}")
    return path.read_text(encoding="utf-8")


def write(path: Path, text: str, dry_run: bool):
    if dry_run:
        print(f"[dry-run] write {path}")
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")
    print(f"[write] {path}")


def replace_once(text: str, old: str, new: str, label: str, required=True) -> str:
    count = text.count(old)
    if count == 0:
        if required:
            raise SystemExit(f"Anchor not found: {label}")
        print(f"[skip] {label} (anchor not found)")
        return text
    if count > 1:
        raise SystemExit(f"Anchor is ambiguous ({count} matches): {label}")
    return text.replace(old, new, 1)


def replace_all(text: str, old: str, new: str, label: str, min_count=1) -> str:
    count = text.count(old)
    if count < min_count:
        raise SystemExit(f"Anchor not found enough times ({count}): {label}")
    print(f"[patch] {label}: {count} occurrence(s)")
    return text.replace(old, new)


def regex_once(text: str, pattern: str, repl, label: str, flags=0, required=True) -> str:
    replacement = (lambda _match: repl) if isinstance(repl, str) else repl
    result, count = re.subn(pattern, replacement, text, count=1, flags=flags)
    if count != 1:
        if required:
            raise SystemExit(f"Regex anchor failed ({count} matches): {label}")
        print(f"[skip] {label} (matches={count})")
        return text
    return result


def inject_in_function(text: str, signature: str, needle: str, addition: str, label: str) -> str:
    start = text.find(signature)
    if start < 0:
        raise SystemExit(f"Function signature not found: {label}")
    next_export = text.find("\nexport ", start + len(signature))
    end = next_export if next_export >= 0 else len(text)
    segment = text[start:end]
    if addition.strip() in segment:
        print(f"[skip] {label} already patched")
        return text
    if needle not in segment:
        raise SystemExit(f"Needle not found inside function: {label}")
    segment = segment.replace(needle, needle + addition, 1)
    return text[:start] + segment + text[end:]


def current_sha(root: Path) -> str | None:
    try:
        return subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=root, text=True, stderr=subprocess.DEVNULL).strip()
    except Exception:
        return None



    '}\n\n'
    'function safeEqualWebhookSecret(left: string, right: string) {\n'
    '  if (!left || !right) return false;\n'
    '  const a = crypto.createHash("sha256").update(left, "utf8").digest();\n'
    '  const b = crypto.createHash("sha256").update(right, "utf8").digest();\n'
    '  return a.length === b.length && crypto.timingSafeEqual(a, b);\n'
    '}\n',
    "integration:add timing-safe custom header comparison",
)

old_auth = '''  const timestamp = String(headers["x-evolution-timestamp"] || "");
  const deliveryId = String(headers["x-evolution-delivery-id"] || "");
  const signatureHeader = String(headers["x-evolution-signature"] || "");
  const signature = signatureHeader.replace(/^sha256=/i, "");
  const timestampNumber = Number(timestamp);
  if (
    !deliveryId ||
    !Number.isFinite(timestampNumber) ||
    Math.abs(Math.floor(Date.now() / 1000) - timestampNumber) >
      WEBHOOK_MAX_AGE_SECONDS
  ) {
    return {
      status: 401,
      body: {
        success: false,
        error: "Invalid webhook timestamp or delivery ID",
      },
    };
  }
  const expected = crypto
    .createHmac("sha256", secret)
    .update(`${timestamp}.${deliveryId}.${rawBody.toString("utf8")}`)
    .digest("hex");
  if (!safeEqualHex(expected, signature))
    return {
      status: 403,
      body: { success: false, error: "Invalid webhook signature" },
    };
'''

new_auth = '''  const customHeaderSecret = String(headers[WEBHOOK_AUTH_HEADER] || "");
  const customHeaderAuthenticated = safeEqualWebhookSecret(
    customHeaderSecret,
    secret
  );
  let deliveryId = String(headers["x-evolution-delivery-id"] || "");

  // Evolution API v2.3.7 supports custom webhook headers but does not generate
  // x-evolution-timestamp/x-evolution-delivery-id/x-evolution-signature itself.
  // Prefer the native custom-header contract and retain the previous HMAC
  // contract only as a backwards-compatible fallback.
  if (customHeaderAuthenticated) {
    if (!deliveryId) {
      deliveryId = crypto
        .createHash("sha256")
        .update(rawBody)
        .digest("hex");
    }
  } else {
    const timestamp = String(headers["x-evolution-timestamp"] || "");
    const signatureHeader = String(headers["x-evolution-signature"] || "");
    const signature = signatureHeader.replace(/^sha256=/i, "");
    const timestampNumber = Number(timestamp);
    if (
      !deliveryId ||
      !Number.isFinite(timestampNumber) ||
      Math.abs(Math.floor(Date.now() / 1000) - timestampNumber) >
        WEBHOOK_MAX_AGE_SECONDS
    ) {
      return {
        status: 401,
        body: {
          success: false,
          error: "Invalid webhook authentication",
        },
      };
    }
    const expected = crypto
      .createHmac("sha256", secret)
      .update(`${timestamp}.${deliveryId}.${rawBody.toString("utf8")}`)
      .digest("hex");
    if (!safeEqualHex(expected, signature))
      return {
        status: 403,
        body: { success: false, error: "Invalid webhook authentication" },
      };
  }
'''

t = replace_once(t, old_auth, new_auth, "integration:Evolution v2.3.7 webhook authentication")
patched["integration"] = t


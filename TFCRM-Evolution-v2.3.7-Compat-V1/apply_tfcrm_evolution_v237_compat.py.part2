    '    return false;\n'
    '  const a = Buffer.from(left, "hex");\n'
    '  const b = Buffer.from(right, "hex");\n'
    '  return a.length === b.length && crypto.timingSafeEqual(a, b);\n'
    '}\n',
    'function safeEqualHex(left: string, right: string) {\n'
    '  if (!/^[a-f0-9]{64}$/i.test(left) || !/^[a-f0-9]{64}$/i.test(right))\n'
    '    return false;\n'
    '  const a = Buffer.from(left, "hex");\n'

#!/usr/bin/env python3
from pathlib import Path
import re

ROOT = Path.cwd()
TARGETS = {
    "integration": ROOT / "server/services/waGatewayIntegrationService.ts",
    "managed": ROOT / "server/services/waGatewayManagedSetupService.ts",
    "ui": ROOT / "client/src/components/WAGatewaySettingsTab.tsx",
}

def fail(msg: str):
    raise SystemExit(f"ERROR: {msg}")

for name, path in TARGETS.items():
    if not path.is_file():
        fail(f"missing target [{name}]: {path}")

originals = {name: path.read_text(encoding="utf-8") for name, path in TARGETS.items()}
patched = dict(originals)

def replace_once(text: str, old: str, new: str, label: str) -> str:
    count = text.count(old)
    if count != 1:
        fail(f"{label}: expected exactly 1 match, found {count}")
    return text.replace(old, new, 1)

